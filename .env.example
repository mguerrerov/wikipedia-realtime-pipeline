# Copiar a .env y ajustar. Docker Compose lo lee solo.

# Que implementacion de la fuente de eventos se usa: kafka | kinesis
FUENTE_EVENTOS=kafka

# --- Local (Redpanda) ---
# Desde otro contenedor: redpanda:9092. Desde el equipo anfitrion: localhost:19092.
KAFKA_BROKERS=redpanda:9092
KAFKA_TOPICO=wikimedia.cambios

# Publica N eventos y para. 0 = sin limite. Util para probar sin dejar nada corriendo.
LIMITE_EVENTOS=0

# --- AWS (Kinesis). Sin usar hasta la fase 6 ---
KINESIS_STREAM=wikimedia-cambios
AWS_REGION=eu-west-1
